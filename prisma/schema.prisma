// ScanReview — auth, membership, onboarding (organizations + spots).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  ADMIN
  MANAGER
}

enum AlertRecipientMode {
  ADMIN
  MANAGER_PENDING
}

model Organization {
  id                  String             @id @default(uuid()) @db.Uuid
  name                String
  businessType        String
  labelPreset         String
  customLabel         String?
  spotLabel           String
  publicReviewUrl     String?
  alertRecipient      AlertRecipientMode
  pendingManagerName  String?
  pendingManagerEmail String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  members             Member[]
  spots               Spot[]
  feedback            Feedback[]
}

model Member {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @unique
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           MemberRole
  alertEmail     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model Spot {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number         Int
  displayName    String
  publicToken    String       @unique
  qrStoragePath  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  feedback       Feedback[]

  @@unique([organizationId, number])
  @@index([organizationId])
}

model Feedback {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  spotId         String       @db.Uuid
  spot           Spot         @relation(fields: [spotId], references: [id], onDelete: Cascade)
  rating         Int
  comment        String?
  contactName    String?
  contactEmail   String?
  contactPhone   String?
  createdAt      DateTime     @default(now())

  @@index([organizationId, createdAt])
  @@index([spotId, createdAt])
}
